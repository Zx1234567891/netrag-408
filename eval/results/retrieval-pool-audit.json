  "judgments": [
    {
      "id": "hold-structure-encapsulation",
      "source_id": "2012_40",
      "relevant": false,
      "reason": "区分邮件流程中的应用协议，不分析跨层承载或传输单元。"
    },
    {
      "id": "hold-structure-encapsulation",
      "source_id": "2013_35",
      "relevant": false,
      "reason": "比较交换方式的传输耗时，明确忽略包头和拆装。"
    },
    {
      "id": "hold-structure-encapsulation",
      "source_id": "2015_35",
      "relevant": false,
      "reason": "求链路滑窗利用率和帧序号位数，不辨认跨层承载。"
    },
    {
      "id": "hold-structure-encapsulation",
      "source_id": "2025_37",
      "relevant": true,
      "reason": "明确以 IP 数据报承载 UDP 为前提，分析网络层地址转换及其对所承载报文头的影响。"
    },
    {
      "id": "hold-structure-encapsulation",
      "source_id": "2025_47",
      "relevant": false,
      "reason": "各层开销仅作忽略条件，实质是卫星链路延时、窗口和子网配置。"
    },
    {
      "id": "hold-structure-delay",
      "source_id": "2016_34",
      "relevant": false,
      "reason": "以香农容量和给定比例求实际速率，没有计算任何时延或带宽时延积。"
    },
    {
      "id": "hold-structure-topology",
      "source_id": "2025_33",
      "relevant": false,
      "reason": "网络可达条件已经给定，比较交换方式下的传输时间，不推断设备更换后的转发、广播或冲突可达性。"
    },
    {
      "id": "hold-link-ethernet",
      "source_id": "2012_35",
      "relevant": false,
      "reason": "只识别 MAC 服务语义，没有碰撞检测、帧长或退避。"
    },
    {
      "id": "hold-link-ethernet",
      "source_id": "2019_36",
      "relevant": true,
      "reason": "直接用 CSMA/CD 的最小帧长约束反推冲突域可容许的传播时延。"
    },
    {
      "id": "hold-link-bridge",
      "source_id": "2019_47",
      "relevant": true,
      "reason": "要求判断广播由交换机传播到哪些主机，解析说明路由器如何隔离该广播边界。"
    },
    {
      "id": "hold-link-stop",
      "source_id": "2017_47",
      "relevant": false,
      "reason": "题设及推导都是允许多帧在途的 GBN，没有停等的单帧等待约束。"
    },
    {
      "id": "hold-link-error",
      "source_id": "2011_47",
      "relevant": false,
      "reason": "帧格式示意仅列出 CRC 尾字段，不讨论其检错功能或算法。"
    },
    {
      "id": "hold-net-summary",
      "source_id": "concept-longest-prefix",
      "relevant": false,
      "reason": "从已存在的条目选最长匹配，不合并条目或验证汇总边界。"
    },
    {
      "id": "hold-net-forward",
      "source_id": "2011_37",
      "relevant": false,
      "reason": "求一条汇总静态路由及相邻下一跳，没有按具体目的地址在条目中选择，也未配置默认或主机路由。"
    },
    {
      "id": "hold-net-forward",
      "source_id": "2026_37",
      "relevant": false,
      "reason": "根据断链与前缀聚合计算表项数；默认和主机路由已经给定，不执行指定目的地址的查表。"
    },
    {
      "id": "hold-net-arp",
      "source_id": "2011_47",
      "relevant": true,
      "reason": "本题正文及嵌入解答直接要求识别首跳网关 MAC，并说明 ARP 请求的链路广播地址。"
    },
    {
      "id": "hold-net-fragment",
      "source_id": "2024_36",
      "relevant": false,
      "reason": "求无线局域网预约信道的 NAV，不涉及 IPv4 分片字段。"
    },
    {
      "id": "hold-net-fragment",
      "source_id": "2025_37",
      "relevant": false,
      "reason": "考查 NAT 改写 UDP 字段，没有 MTU、片偏移或分片标志计算。"
    },
    {
      "id": "hold-trans-handshake",
      "source_id": "2013_39",
      "relevant": false,
      "reason": "已建立连接，计算正常数据交换的序号和确认号，不涉及初始序号或建连报文。"
    },
    {
      "id": "hold-trans-handshake",
      "source_id": "2016_41",
      "relevant": true,
      "reason": "有独立小问计算第二次握手段的 SYN、ACK 标志及确认号。"
    },
    {
      "id": "hold-trans-handshake",
      "source_id": "2024_38",
      "relevant": true,
      "reason": "虽然题目求全流程耗时，解析确实列出三次握手中的 SYN、SYN+ACK 和 ACK。"
    },
    {
      "id": "hold-trans-handshake",
      "source_id": "concept-tcp-ack",
      "relevant": false,
      "reason": "解释数据字节的累计确认和缺口，不涉及建连或交换初始序号。"
    },
    {
      "id": "hold-trans-ack",
      "source_id": "2016_41",
      "relevant": false,
      "reason": "数据阶段求通告窗口及下一发送序号，没有按接收字节推进数据 ACK 或讨论重复、乱序确认。"
    },
    {
      "id": "hold-trans-ack",
      "source_id": "2023_47",
      "relevant": true,
      "reason": "数据阶段的解析把各已收到字节范围与相应的累计确认号逐一配对。"
    },
    {
      "id": "hold-trans-ack",
      "source_id": "2024_38",
      "relevant": false,
      "reason": "只是将接收累积确认作为耗时阶段，不计算数据确认号的字节级推进。"
    },
    {
      "id": "hold-trans-teardown",
      "source_id": "2022_38",
