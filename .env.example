# Set these as process environment variables. uvicorn can also load an env file
# with `--env-file .env` if python-dotenv is installed.
# NETRAG_DATA_DIR=local_data
# NETRAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# NETRAG_RERANKER_MODEL=BAAI/bge-reranker-base
# NETRAG_USE_JIEBA=1
# NETRAG_USE_FAISS=1
# NETRAG_CANDIDATE_K=20
# NETRAG_BM25_WEIGHT=1
# NETRAG_DENSE_WEIGHT=1
# NETRAG_LLM_BASE_URL=http://127.0.0.1:11434/v1
# NETRAG_LLM_MODEL=your-local-model
# NETRAG_LLM_API_KEY=
# NETRAG_LLM_TIMEOUT=4
# NETRAG_LLM_JSON_MODE=1
